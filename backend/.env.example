# MongoDB Atlas Connection String
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/legal_metrology?retryWrites=true&w=majority
DB_NAME=legal_metrology

# JWT Security
JWT_SECRET=lm-compliance-engine-secret-key-2026-secure

# Default Seed Accounts
ADMIN_EMAIL=admin@lm.gov.in
ADMIN_PASSWORD=admin123
OFFICER_EMAIL=officer@lm.gov.in
OFFICER_PASSWORD=officer123

# CORS Allowed Origins (Comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://lm-compliance.vercel.app

# Optional Google AI Studio Key (or pass dynamically via Scanner UI)
GEMINI_API_KEY=
